// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  // output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  login     String
  password  String
  version   Int
  createdAt DateTime
  updatedAt DateTime
}

model Album {
  id         String    @id @default(uuid())
  name       String
  year       Int
  tracks     Track[]
  artist     Artist?   @relation(fields: [artistId], references: [id])
  artistId   String?
  favorite   Favs? @relation(fields: [favoriteId], references: [id])
  favoriteId String?
}

model Artist {
  id         String    @id @default(uuid())
  name       String
  grammy     Boolean
  tracks     Track[]
  albums     Album[]
  favorite   Favs? @relation(fields: [favoriteId], references: [id])
  favoriteId String?
}

model Track {
  id         String    @id @default(uuid())
  name       String
  album      Album?    @relation(fields: [albumId], references: [id])
  albumId    String?
  artist     Artist?   @relation(fields: [artistId], references: [id])
  artistId   String?
  duration   Int
  favorite   Favs? @relation(fields: [favoriteId], references: [id])
  favoriteId String?
}

model Favs {
  id      String   @id @default(uuid())
  tracks  Track[]
  artists Artist[]
  albums  Album[]
}
